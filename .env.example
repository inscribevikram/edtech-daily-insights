# Apollo.io API key (Settings > API in Apollo dashboard)
APOLLO_API_KEY=your_apollo_api_key
APOLLO_ENRICH_TOP_N=10

# Google Sheets service account (Google Cloud Console > IAM > Service Accounts)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_sheet_id

# Optional: shown as a link in the dashboard header
NEXT_PUBLIC_SHEET_LINK=https://docs.google.com/spreadsheets/d/your_google_sheet_id